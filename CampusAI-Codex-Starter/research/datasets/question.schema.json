{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CampusAI evaluation question",
  "type": "object",
  "additionalProperties": false,
  "required": ["question_id", "question", "relevant_chunk_ids", "expected_abstain"],
  "properties": {
    "question_id": {"type": "string", "minLength": 1, "maxLength": 80},
    "question": {"type": "string", "minLength": 3, "maxLength": 3000},
    "dataset_version": {"type": ["string", "null"], "minLength": 1},
    "language": {"enum": ["en", "hi", "kn"], "default": "en"},
    "as_of": {"type": ["string", "null"], "format": "date-time"},
    "category": {"type": ["string", "null"]},
    "company_id": {"type": ["integer", "null"], "minimum": 1},
    "academic_year": {"type": ["string", "null"]},
    "document_version": {"type": ["integer", "null"], "minimum": 1},
    "expected_answer": {"type": ["string", "null"]},
    "relevant_chunk_ids": {"type": "array", "maxItems": 100, "items": {"type": "integer", "minimum": 1}},
    "expected_abstain": {"type": "boolean"},
    "eligibility_case": {
      "type": ["object", "null"],
      "required": ["student", "requirements", "source_approved"],
      "additionalProperties": false,
      "properties": {
        "source_approved": {"type": "boolean"},
        "student": {"type": "object", "additionalProperties": false, "properties": {
          "cgpa": {"type": ["number", "null"], "minimum": 0, "maximum": 10}, "branch": {"type": ["string", "null"]},
          "graduation_year": {"type": ["integer", "null"], "minimum": 1}, "active_backlogs": {"type": ["integer", "null"], "minimum": 0},
          "historical_backlogs": {"type": ["integer", "null"], "minimum": 0}, "technical_skills": {"type": "array", "items": {"type": "string"}}
        }},
        "requirements": {"type": "object", "additionalProperties": false, "required": ["criteria_reviewed", "source_document_id"], "properties": {
          "min_cgpa": {"type": ["number", "null"], "minimum": 0, "maximum": 10}, "eligible_branches": {"type": ["array", "null"], "items": {"type": "string"}},
          "graduation_years": {"type": ["array", "null"], "items": {"type": "integer", "minimum": 1}},
          "max_active_backlogs": {"type": ["integer", "null"], "minimum": 0}, "max_historical_backlogs": {"type": ["integer", "null"], "minimum": 0},
          "required_skills": {"type": "array", "items": {"type": "string"}},
          "criteria_reviewed": {"type": "boolean"}, "source_document_id": {"type": ["integer", "null"], "minimum": 1}, "rule_version": {"type": ["integer", "null"], "minimum": 1}
        }}
      }
    },
    "annotation": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "answer_correct": {"type": ["boolean", "null"]},
        "faithful": {"type": ["boolean", "null"]},
        "citation_correct": {"type": ["boolean", "null"]},
        "unsupported_claims": {"type": ["integer", "null"], "minimum": 0},
        "temporal_correct": {"type": ["boolean", "null"]},
        "current_policy_correct": {"type": ["boolean", "null"]},
        "historical_retrieval_correct": {"type": ["boolean", "null"]},
        "version_identification_correct": {"type": ["boolean", "null"]},
        "outdated_warning_correct": {"type": ["boolean", "null"]},
        "conflict_detection_correct": {"type": ["boolean", "null"]},
        "eligibility_actual": {"enum": ["eligible", "not_eligible", "needs_manual_verification", null]},
        "reviewer_id": {"type": ["string", "null"]}
      }
    }
  }
}
