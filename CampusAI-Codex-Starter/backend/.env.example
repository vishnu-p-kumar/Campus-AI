# Resume review and role skill guidance.
GEMINI_API_KEY=
# Separate key for placement assistant answers and admin-authorized URL Context.
GEMINI_PLACEMENT_API_KEY=
# Separate key for interview preparation and practice.
GEMINI_CHAT_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite,gemini-2.5-flash,gemini-3.1-flash-lite,gemini-3.8-flash,gemini-3.6-flash
# URL Context is disabled until explicitly enabled by the server and administrator.
GEMINI_URL_CONTEXT_ENABLED=false
ENVIRONMENT=development
# The application defaults to SQLite when neither DATABASE_URL nor all
# POSTGRES_* components are set. An explicit DATABASE_URL takes precedence.
# Set all POSTGRES_* values to construct an escaped SQLAlchemy psycopg URL.
# For Docker PostgreSQL, set DATABASE_URL to the Compose connection URL.
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=campusai_document_chunks
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Optional NLI model with entailment/neutral/contradiction labels. Verify its model card before enabling.
FAITHFULNESS_MODEL=
FAITHFULNESS_MIN_ENTAILMENT=0.70
# Provisional heuristic cutoff only; set after institution-specific held-out validation.
EVIDENCE_MINIMUM_SCORE=0.35
JWT_SECRET_KEY=development-only-change-me-before-deploy
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
AUTH_RATE_LIMIT_PER_MINUTE=20
CORS_ORIGINS=http://localhost:3101,http://127.0.0.1:3101
UPLOAD_DIRECTORY=./uploads
MAX_UPLOAD_SIZE=10000000
DOCUMENT_INGESTION_MODE=inline
INGESTION_MAX_ATTEMPTS=3
INGESTION_WORKER_POLL_SECONDS=2
INGESTION_JOB_LEASE_SECONDS=1800
# Optional scanned-PDF OCR. Requires system Tesseract and the selected language data.
OCR_ENABLED=false
OCR_LANGUAGES=eng
OCR_DPI=200
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
PASSWORD_RESET_URL=http://localhost:3000/reset-password

